import java.util.*;
class factff{
    public static void main(String[] args) {
        Scanner sc =new Scanner(System.in);
        int a=sc.nextInt();
       boolean isPrime=true;
       for(int i=2; i<=a-1;i++){
        if(a%i==0){
            isPrime=false;
        }
       }
       if(isPrime==true){
        System.out.println("Prime");
       }else{
        System.out.print("not prime");
       }



        }
