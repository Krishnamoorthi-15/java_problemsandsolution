import java.util.*;
class right{

    public static void main (String []args){

        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the value of n:");
        int n = sc.nextInt();

        for(int i = n; i>=1; i--){

            for(int col=i ; col>=1; col--){

                System.out.print("*");
            }
            System.out.println();
        }
        

    }
    
    
}
