import java.util.*;
class factff{
    public static void main(String[] args) {
        Scanner sc =new Scanner(System.in);
        int a=sc.nextInt();
        int Number=0;
        while(a!=0){
            int digit=a%10;
            Number=Number*10+digit;
            a/=10;



        }
        System.out.println(Number);
        
    }
}
